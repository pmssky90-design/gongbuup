[
  {
    "id": "title_modifier_001",
    "text": "기초부터 차근차근 점검하는"
  },
  {
    "id": "title_modifier_002",
    "text": "내신 흐름을 세밀하게 살펴보는"
  },
  {
    "id": "title_modifier_003",
    "text": "개념과 문제풀이를 함께 보는"
  },
  {
    "id": "title_modifier_004",
    "text": "학습 습관을 현실적으로 조정하는"
  },
  {
    "id": "title_modifier_005",
    "text": "시험 준비 방향을 구체적으로 정리하는"
  },
  {
    "id": "title_modifier_006",
    "text": "오답 관리까지 자연스럽게 연결하는"
  },
  {
    "id": "title_modifier_007",
    "text": "과목별 공부 순서를 균형 있게 살펴보는"
  },
  {
    "id": "title_modifier_008",
    "text": "현재 수준에 맞춰 단계적으로 접근하는"
  },
  {
    "id": "title_modifier_009",
    "text": "복습 주기와 학습량을 함께 조절하는"
  },
  {
    "id": "title_modifier_010",
    "text": "질문과 설명 습관을 차분히 기르는"
  },
  {
    "id": "title_modifier_011",
    "text": "교과 진도와 취약 부분을 함께 확인하는"
  },
  {
    "id": "title_modifier_012",
    "text": "주간 계획과 실천 결과를 비교하는"
  },
  {
    "id": "title_modifier_013",
    "text": "핵심 개념의 연결 관계를 다시 보는"
  },
  {
    "id": "title_modifier_014",
    "text": "문제 해결 과정을 근거부터 확인하는"
  },
  {
    "id": "title_modifier_015",
    "text": "집중 시간과 공부 분량을 알맞게 나누는"
  },
  {
    "id": "title_modifier_016",
    "text": "시험 범위와 우선순위를 미리 정하는"
  },
  {
    "id": "title_modifier_017",
    "text": "서술 과정과 답의 근거를 함께 점검하는"
  },
  {
    "id": "title_modifier_018",
    "text": "스스로 공부하는 기준을 조금씩 세우는"
  },
  {
    "id": "title_modifier_019",
    "text": "반복 학습의 시점과 방법을 조정하는"
  },
  {
    "id": "title_modifier_020",
    "text": "취약한 부분을 기록하며 보완하는"
  },
  {
    "id": "title_modifier_021",
    "text": "과목 특성에 맞는 복습 방법을 찾는"
  },
  {
    "id": "title_modifier_022",
    "text": "매일 이어갈 수 있는 학습 리듬을 만드는"
  },
  {
    "id": "title_modifier_023",
    "text": "이해와 적용의 순서를 분명하게 잡는"
  },
  {
    "id": "title_modifier_024",
    "text": "학습 기록을 다음 계획으로 연결하는"
  },
  {
    "id": "title_modifier_025",
    "text": "실수를 유형별로 나누어 돌아보는"
  },
  {
    "id": "title_modifier_026",
    "text": "목표와 실제 공부량을 함께 비교하는"
  },
  {
    "id": "title_modifier_027",
    "text": "교과 내용을 자신의 말로 설명해 보는"
  },
  {
    "id": "title_modifier_028",
    "text": "풀이 근거와 판단 순서를 꼼꼼히 살피는"
  },
  {
    "id": "title_modifier_029",
    "text": "단기 목표와 누적 복습을 함께 배치하는"
  },
  {
    "id": "title_modifier_030",
    "text": "학습 부담을 나누어 꾸준히 이어가는"
  }
]
